# =============================================================================
# TG WS Proxy - Docker Compose configuration
# =============================================================================
#
# Copy this file to .env:
#
#   cp .env.example .env
#
# Or define the variables directly in your Docker management system
# (Dockhand, Portainer, etc.).
#
# Upstream project:
# https://github.com/Flowseal/tg-ws-proxy
#
# =============================================================================


# -----------------------------------------------------------------------------
# Docker published port
# -----------------------------------------------------------------------------
#
# Port exposed on the Docker host.
#
# This is a Docker Compose-only setting and is NOT an upstream
# TG WS Proxy environment variable.
#
# Default:
# TG_WS_PROXY_PUBLISHED_PORT=1443
#
# Example:
# TG_WS_PROXY_PUBLISHED_PORT=443


# -----------------------------------------------------------------------------
# Listen address
# -----------------------------------------------------------------------------
#
# Address TG WS Proxy listens on inside the container.
#
# Normally this should remain 0.0.0.0 when running inside Docker.
#
# Default:
# TG_WS_PROXY_HOST=0.0.0.0


# -----------------------------------------------------------------------------
# Listen port
# -----------------------------------------------------------------------------
#
# Port TG WS Proxy listens on inside the container.
#
# Default:
# TG_WS_PROXY_PORT=1443


# -----------------------------------------------------------------------------
# MTProto secret
# -----------------------------------------------------------------------------
#
# 32 hexadecimal characters.
#
# Generate one with:
#
#   openssl rand -hex 16
#
# Example:
# TG_WS_PROXY_SECRET=7843b24403c17c32e1805bbec78fb63a
#
# Do NOT add the "dd" prefix.
#
# If left empty, TG WS Proxy generates a random secret on startup.
#
# IMPORTANT:
# For a permanent server it is recommended to explicitly configure
# the secret, otherwise it may change after container recreation.
#
TG_WS_PROXY_SECRET=


# -----------------------------------------------------------------------------
# Telegram datacenter IPs
# -----------------------------------------------------------------------------
#
# Space-separated list in:
#
#   DC:IP
#
# format.
#
# Default:
# TG_WS_PROXY_DC_IPS=2:149.154.167.220 4:149.154.167.220
#
# Example:
# TG_WS_PROXY_DC_IPS=2:149.154.167.220 4:149.154.167.220


# -----------------------------------------------------------------------------
# Cloudflare Worker
# -----------------------------------------------------------------------------
#
# Optional Cloudflare Worker domain used as a fallback.
#
# Leave empty to disable.
#
# Example:
# TG_WS_PROXY_CF_WORKER=example.workers.dev
#
# Default:
# TG_WS_PROXY_CF_WORKER=
